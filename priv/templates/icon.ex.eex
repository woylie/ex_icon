defmodule <%= inspect(@module_name) %> do
  @moduledoc """
  Provides function components for icons.

  This file is generated. Do not edit.
  """
  use Phoenix.Component
<%= for {name, {svg, attrs}} <- @icons do %><%= for {attr, opts} <- attrs do %>
  attr :<%= attr %>, :string, <%= ExIcon.render_attr_options(opts) %><% end %>

  def <%= name %>(assigns) do
    ~H"""
<%= ExIcon.indent(svg, 4) %>
    """
  end
<% end %>end
